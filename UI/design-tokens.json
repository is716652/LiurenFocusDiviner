  },

  "盘面视觉参数": {
    "盘型": "双环同心圆 + 天将环（外圈地盘，中圈天盘，内圈天将）",
    "地盘环": "墨青底、text_primary 字、外圈遁干小字（text_secondary）",
    "天盘环": "tian_line 描边虚线、tian_bg 底、gold 字 + 遁干小字",
    "天将环": "按吉凶着色：吉=verdigris、凶=cinnabar、中性=porcelain",
    "三传标记": "初传=cinnabar、中传=verdigris、末传=porcelain",
    "交互": "点击宫位 → 详情浮层（radius_xlarge=32 半模态规格）"
  },

  "ArkTS映射说明": {
    "颜色": "resources/base/element/color.json + resources/dark/element/color.json（同名双值）",
    "字号行高": "resources/base/element/float.json（fp）",
    "圆角间距": "float.json 中 radius_*/space_* 或封装 RadiusTokens/SpacingTokens 静态类",
    "文本样式": "TextStyles.ets（fontSize+fontWeight+fontColor 解耦模式）",
    "响应式": "@State windowWidth + 根容器 .onAreaChange + 断点 600/840/1280",
    "单位": "布局用 vp、字号用 fp，禁用 px",
    "深浅切换": "系统自动按 resources/base vs dark 切换，无需代码判断"
  },

  "校验记录": {
    "对照源": "HarmonyOS-Design/AGENTS.md（官方规范硬数值）",
    "通过项": [
      "Type Scale 五类字号与官方一致",
      "圆角五档 4/8/16/20/32 与官方一致",
      "间距 4/8 栅格与官方一致",
      "深浅双模式同名 Token 双色值结构符合官方要求",
      "语义化命名（brand_/text_/background/surface/divider）符合官方约定"
    ]
  }
}
