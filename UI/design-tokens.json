{
  "元数据": {
    "名称": "大六壬排盘 Design Tokens",
    "版本": "1.0.0",
    "状态": "定稿",
    "体系": "HarmonyOS Design 规范对齐（Token 语义化 / Type Scale / 圆角间距标准档位 / 深浅双模式）",
    "用途": "Web（CSS 变量）与鸿蒙 ArkTS（$r 资源）双端唯一真源",
    "说明": "三套风格 A墨夜鎏金 / B宣纸古籍 / C青瓷素雅，每套含浅色(base)/深色(dark) 双值；ArkTS 中同名 Token 放 resources/base 与 resources/dark 两份文件，系统自动切换",
    "默认风格": "A（墨夜鎏金）",
    "字体": "HarmonyOS Sans（不指定 fontFamily，系统默认）"
  },

  "字体TypeScale": {
    "说明": "fp 单位；Web 用 px 近似（1fp≈1px）",
    "display_l": 56, "display_m": 48, "display_s": 38,
    "title_l": 30, "title_m": 24, "title_s": 20,
    "subtitle_l": 18, "subtitle_m": 16, "subtitle_s": 14,
    "body_l": 16, "body_m": 14, "body_s": 12,
    "caption_l": 12, "caption_m": 10,
    "字重映射": {
      "Light(300)": "FontWeight.Lighter",
      "Regular(400)": "FontWeight.Regular",
      "Medium(500)": "FontWeight.Medium",
      "Bold(700)": "FontWeight.Bold"
    }
  },

  "圆角档位": {
    "radius_xsmall": 4,
    "radius_small": 8,
    "radius_medium": 16,
    "radius_large": 20,
    "radius_xlarge": 32,
    "说明": "只用这五档；卡片16/按钮20/弹窗32"
  },

  "间距栅格": {
    "space_xsmall": 4, "space_small": 8, "space_medium": 12, "space_large": 16,
    "space_xlarge": 20, "space_xxlarge": 24,
    "margin_page_horizontal": 16, "margin_page_top": 36, "margin_page_bottom": 28,
    "说明": "4/8 栅格体系；禁 5/7/13/19 等中间值"
  },

  "断点": {
    "xs": 600, "sm": 840, "md": 1280,
    "说明": "以应用窗口宽度为准；<600单列 / 600-840双列 / 840-1280侧边Tab或分栏 / ≥1280侧边导航"
  },

  "风格A_墨夜鎏金": {
